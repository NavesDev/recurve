DB_URL=jdbc:postgresql://localhost:54330/recurve-database
DB_USER=postgres
DB_PASSWORD=postgres

# First operator, created on startup only when the users table is empty.
# Leave blank to skip; the API is unusable until one operator exists.
BOOTSTRAP_ADMIN_EMAIL=admin@recurve.local
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Swagger UI and the API contract at /docs, open to anyone. Off in production.
DOCS_ENABLED=true

# Payment gateway (FR-04.7): fake | asaas. With asaas, the key and the
# webhook token are required. The token is the one configured on the
# Asaas webhook (32-255 characters); never put a real key in this file.
PAYMENT_GATEWAY=fake
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
